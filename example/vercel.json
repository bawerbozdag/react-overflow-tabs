{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build:static",
    "outputDirectory": "dist/static",
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "en"
                }
            ]
        },
        {
            "source": "/tr",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "tr"
                }
            ]
        },
        {
            "source": "/zh",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "zh-CN"
                }
            ]
        },
        {
            "source": "/es",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "es"
                }
            ]
        },
        {
            "source": "/fr",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "fr"
                }
            ]
        },
        {
            "source": "/pt",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "pt-BR"
                }
            ]
        },
        {
            "source": "/ru",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "ru"
                }
            ]
        },
        {
            "source": "/ja",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "ja"
                }
            ]
        },
        {
            "source": "/de",
            "headers": [
                {
                    "key": "Content-Language",
                    "value": "de"
                }
            ]
        }
    ]
}

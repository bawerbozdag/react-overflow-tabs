{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["vite/client", "node"],
        "paths": { "react-overflow-tabs": ["../src/index.ts"] }
    },
    "include": ["src", "vite.config.ts"]
}
